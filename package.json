{
  "name": "desktop-tracker-suite",
  "version": "2.0.2",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Guan Xin Wang",
  "description": "Desktop Tracker Suite workspace with a Tauri shell, Angular frontend, and Nest backend",
  "scripts": {
    "with-env": "node --loader ts-node/esm tools/with-env.ts",
    "__________________DEVELOPMENT: WEB__________________": "--------------------------------------------------------",
    "dev-ng": "nx serve ng-tracker",
    "dev-vue": "nx serve vue-tracker",
    "dev-react": "nx serve react-tracker",
    "____________________HELPER: ENVS____________________": "--------------------------------------------------------",
    "env:dev": "bun run --silent with-env --profile dev --",
    "env:prod": "bun run --silent with-env --profile prod --",
    "________________DEVELOPMENT: BACKEND________________": "--------------------------------------------------------",
    "dev-nest": "bun run --silent with-env --profile dev -- nx serve nest-backend --watch",
    "dev-express": "bun run --silent with-env --profile dev -- nx serve express-backend --watch",
    "dev-spring": "bun run --silent with-env --profile dev -- nx serve spring-backend",
    "prod-nest": "bun run --silent with-env --profile prod -- nx serve nest-backend --watch",
    "_____________________BUILD: WEB_____________________": "--------------------------------------------------------",
    "build-ng": "nx build ng-tracker --configuration=development --optimization --base-href ./",
    "build-vue": "nx build vue-tracker",
    "build-react": "nx build react-tracker",
    "build-prod-ng": "nx build ng-tracker --configuration production --optimization --base-href ./",
    "build-prod-vue": "nx build vue-tracker",
    "build-prod-react": "nx build react-tracker",
    "___________________BUILD: BACKEND___________________": "--------------------------------------------------------",
    "build-nest": "bun run --silent with-env --profile dev -- nx build nest-backend",
    "build-express": "bun run --silent with-env --profile dev -- nx build express-backend",
    "build-spring": "nx build spring-backend",
    "build-spring-native": "bun x nx run spring-backend:native-build",
    "build-prod-nest": "bun run --silent with-env --profile prod -- nx build nest-backend",
    "build-prod-express": "bun run --silent with-env --profile prod -- nx build express-backend",
    "______________________DESKTOP______________________": "--------------------------------------------------------",
    "desktop:dev": "bun x nx run tauri-shell:dev",
    "desktop:build": "bun x nx run tauri-shell:build",
    "desktop:build:express-sidecar": "bun x nx run tauri-shell:build-express-sidecar",
    "desktop:build:spring-native": "bun x nx run tauri-shell:build-spring-native",
    "desktop:package": "bun x nx run tauri-shell:package",
    "desktop:package:express-sidecar": "bun x nx run tauri-shell:package-express-sidecar",
    "desktop:package:spring-native": "bun x nx run tauri-shell:package-spring-native",
    "desktop:materialize-runtime": "bun x nx run tauri-shell:materialize-backend-runtime",
    "desktop:materialize-runtime:express-sidecar": "bun x nx run tauri-shell:materialize-express-sidecar-runtime",
    "desktop:materialize-spring-native-runtime": "bun x nx run tauri-shell:materialize-spring-native-runtime",
    "desktop:smoke-runtime": "bun x nx run tauri-shell:smoke:nest-sidecar",
    "desktop:smoke-runtime:express-sidecar": "bun x nx run tauri-shell:smoke:express-sidecar",
    "desktop:grid:prepare:one": "bun x nx run tauri-shell:grid-prepare-one",
    "desktop:grid:verify:one": "bun x nx run tauri-shell:grid-verify-one",
    "desktop:grid:verify": "bun x nx run tauri-shell:grid-verify",
    "desktop:grid:package:one": "bun x nx run tauri-shell:grid-package-one",
    "desktop:measure-baseline": "node tools/feasibility/measure-desktop-baseline.ts",
    "desktop:measure-spring-native": "node tools/feasibility/measure-desktop-spring-native.ts",
    "desktop:measure-package": "node tools/feasibility/measure-tauri-package.ts nest",
    "desktop:measure-package:express-sidecar": "node tools/feasibility/measure-tauri-package.ts express",
    "desktop:measure-package:spring-native": "node tools/feasibility/measure-tauri-package.ts spring-native",
    "smoke-spring-native": "bun x nx run spring-backend:smoke-native",
    "desktop:test:tooling": "node --test tools/tauri/*.test.ts",
    "dev-tauri-ng": "bun run desktop:dev",
    "build-tauri-ng": "bun run desktop:build",
    "package-tauri-ng": "bun run desktop:package",
    "materialize-tauri-runtime": "bun run desktop:materialize-runtime",
    "smoke-tauri-runtime": "bun run desktop:smoke-runtime",
    "_______________________TESTING______________________": "--------------------------------------------------------",
    "test-back:cov": "vitest --coverage --root=apps/nest-backend --exclude=**/test/*e2e-spec.ts --watch=false",
    "_______________________REVIEW_______________________": "--------------------------------------------------------",
    "review:status": "node tools/scripts/review-gate/status.ts",
    "review:approve-pre-implementation": "node tools/scripts/review-gate/approve-pre-implementation.ts",
    "review:reset": "node tools/scripts/review-gate/reset.ts",
    "review:checkpoint": "node tools/scripts/review/run-checkpoint-review.ts",
    "review:providers:doctor": "node tools/scripts/review/provider-doctor.ts",
    "review:plan": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint plan --provider auto --focus general",
    "review:plan:risky": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint plan --provider gemini --model gemini-2.5-pro --focus general",
    "review:implementation": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint implementation --provider auto --focus general",
    "review:test": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint test --provider auto --focus tests",
    "review:local:doctor": "node tools/scripts/review/local-reviewer.ts doctor",
    "review:local:staged": "node tools/scripts/review/local-reviewer.ts staged",
    "review:local:prefilter": "node tools/scripts/review/local-reviewer.ts prefilter",
    "review:evaluate:local": "node tools/scripts/review/local-reviewer.ts evaluate",
    "review:copilot": "node tools/scripts/review/run-checkpoint-review.ts --provider copilot",
    "review:gemini": "node tools/scripts/review/run-checkpoint-review.ts --provider gemini",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "check": "bun check --no-script -b -p apps/ng-tracker --no-pretty && bun check --no-script -b -p apps/react-tracker --no-pretty && bun check --no-script -b -p apps/vue-tracker --no-pretty && bun check --no-script -b -p apps/nest-backend --no-pretty && bun check --no-script -b -p apps/express-backend --no-pretty && bun check --no-script -b -p libs/task-domain --no-pretty && bun check --no-script -p tools/tsconfig.json --no-pretty && bun check --no-script -p tools/scripts/tsconfig.json --no-pretty && bun check --no-script -p tools/scripts/tsconfig.spec.json --no-pretty"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "22.2.3",
    "@angular-devkit/schematics": "22.2.3",
    "@angular/animations": "22.2.3",
    "@angular/build": "22.2.3",
    "@angular/cli": "22.2.3",
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/compiler-cli": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/language-service": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "@angular/router": "22.2.3",
    "@nestjs/schematics": "12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@nx/angular": "23.3.0",
    "@nx/js": "23.3.0",
    "@nx/maven": "23.3.0",
    "@nx/nest": "23.3.0",
    "@nx/node": "23.3.0",
    "@nx/react": "23.3.0",
    "@nx/rspack": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@nx/vue": "23.3.0",
    "@nx/web": "23.3.0",
    "@nx/workspace": "23.3.0",
    "@rspack/cli": "^2.2.9",
    "@rspack/core": "^2.2.9",
    "@rspack/dev-server": "^2.2.1",
    "@rspack/plugin-react-refresh": "^2.0.2",
    "@schematics/angular": "22.2.3",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.18",
    "@swc/helpers": "0.5.23",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "@yao-pkg/pkg": "6.23.0",
    "env-cmd": "^11.0.0",
    "jiti": "2.7.0",
    "jsdom": "^30.1.3",
    "nx": "23.3.0",
    "postcss": "^8.5.6",
    "react-refresh": "~0.19.0",
    "tailwindcss": "^4.3.3",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  },
  "dependencies": {
    "@angular/cdk": "22.2.3",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/typeorm": "^12.0.2",
    "@primeuix/themes": "^3.0.2",
    "@primevue/themes": "^4.5.4",
    "@tailwindcss/postcss": "^4.3.3",
    "@tauri-apps/plugin-updater": "2.14.0",
    "axios": "^1.20.0",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "primeicons": "^8.0.2",
    "primeng": "^22.1.3",
    "primereact": "^10.9.9",
    "primevue": "^4.5.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "7.18.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "~7.8.2",
    "sqlite3": "^6.0.1",
    "tailwindcss-primeui": "^0.6.1",
    "tslib": "^2.8.1",
    "typeorm": "^0.3.31",
    "uuid": "^14.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "bun@1.4.3-canary.20261019.1",
  "trustedDependencies": [
    "@nestjs/core",
    "@swc/core",
    "esbuild",
    "nx",
    "sqlite3"
  ]
}
