{
  "name": "desktop-tracker-suite",
  "version": "1.4.2",
  "type": "module",
  "sideEffects": false,
  "license": "MIT",
  "author": "Guan Xin Wang",
  "description": "Desktop Tracker Suite workspace with a Tauri shell, Angular frontend, and Nest backend",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "with-env": "node --loader ts-node/esm tools/with-env.ts",
    "__________________DEVELOPMENT: WEB__________________": "--------------------------------------------------------",
    "dev-ng": "nx serve ng-tracker",
    "dev-vue": "nx serve vue-tracker",
    "dev-react": "nx serve react-tracker",
    "____________________HELPER: ENVS____________________": "--------------------------------------------------------",
    "env:dev": "pnpm -s run with-env --profile dev --",
    "env:prod": "pnpm -s run with-env --profile prod --",
    "________________DEVELOPMENT: BACKEND________________": "--------------------------------------------------------",
    "dev-nest": "pnpm -s run with-env --profile dev -- nx serve nest-backend --watch",
    "dev-express": "pnpm -s run with-env --profile dev -- nx serve express-backend --watch",
    "dev-spring": "pnpm -s run with-env --profile dev -- nx serve spring-backend",
    "prod-nest": "pnpm -s run with-env --profile prod -- nx serve nest-backend --watch",
    "_____________________BUILD: WEB_____________________": "--------------------------------------------------------",
    "build-ng": "nx build ng-tracker --configuration=development --optimization --base-href ./",
    "build-vue": "nx build vue-tracker",
    "build-react": "nx build react-tracker",
    "build-prod-ng": "nx build ng-tracker --configuration production --optimization --base-href ./",
    "build-prod-vue": "nx build vue-tracker",
    "build-prod-react": "nx build react-tracker",
    "___________________BUILD: BACKEND___________________": "--------------------------------------------------------",
    "build-nest": "pnpm -s run with-env --profile dev -- nx build nest-backend",
    "build-express": "pnpm -s run with-env --profile dev -- nx build express-backend",
    "build-spring": "nx build spring-backend",
    "build-spring-native": "pnpm exec nx run spring-backend:native-build",
    "build-prod-nest": "pnpm -s run with-env --profile prod -- nx build nest-backend",
    "build-prod-express": "pnpm -s run with-env --profile prod -- nx build express-backend",
    "______________________DESKTOP______________________": "--------------------------------------------------------",
    "desktop:dev": "pnpm exec nx run tauri-shell:dev",
    "desktop:build": "pnpm exec nx run tauri-shell:build",
    "desktop:build:express-sidecar": "pnpm exec nx run tauri-shell:build-express-sidecar",
    "desktop:build:spring-native": "pnpm exec nx run tauri-shell:build-spring-native",
    "desktop:package": "pnpm exec nx run tauri-shell:package",
    "desktop:package:express-sidecar": "pnpm exec nx run tauri-shell:package-express-sidecar",
    "desktop:package:spring-native": "pnpm exec nx run tauri-shell:package-spring-native",
    "desktop:materialize-runtime": "pnpm exec nx run tauri-shell:materialize-backend-runtime",
    "desktop:materialize-runtime:express-sidecar": "pnpm exec nx run tauri-shell:materialize-express-sidecar-runtime",
    "desktop:materialize-spring-native-runtime": "pnpm exec nx run tauri-shell:materialize-spring-native-runtime",
    "desktop:smoke-runtime": "pnpm exec nx run tauri-shell:smoke:nest-sidecar",
    "desktop:smoke-runtime:express-sidecar": "pnpm exec nx run tauri-shell:smoke:express-sidecar",
    "desktop:grid:prepare:one": "pnpm exec nx run tauri-shell:grid-prepare-one",
    "desktop:grid:verify:one": "pnpm exec nx run tauri-shell:grid-verify-one",
    "desktop:grid:verify": "pnpm exec nx run tauri-shell:grid-verify",
    "desktop:grid:package:one": "pnpm exec nx run tauri-shell:grid-package-one",
    "desktop:measure-baseline": "node tools/feasibility/measure-desktop-baseline.ts",
    "desktop:measure-spring-native": "node tools/feasibility/measure-desktop-spring-native.ts",
    "desktop:measure-package": "node tools/feasibility/measure-tauri-package.ts nest",
    "desktop:measure-package:express-sidecar": "node tools/feasibility/measure-tauri-package.ts express",
    "desktop:measure-package:spring-native": "node tools/feasibility/measure-tauri-package.ts spring-native",
    "smoke-spring-native": "pnpm exec nx run spring-backend:smoke-native",
    "desktop:test:tooling": "node --test tools/tauri/*.test.ts",
    "dev-tauri-ng": "pnpm run desktop:dev",
    "build-tauri-ng": "pnpm run desktop:build",
    "package-tauri-ng": "pnpm run desktop:package",
    "materialize-tauri-runtime": "pnpm run desktop:materialize-runtime",
    "smoke-tauri-runtime": "pnpm run desktop:smoke-runtime",
    "_______________________TESTING______________________": "--------------------------------------------------------",
    "test-back:cov": "vitest --coverage --root=apps/nest-backend --exclude=**/test/*e2e-spec.ts --watch=false",
    "_______________________REVIEW_______________________": "--------------------------------------------------------",
    "review:status": "node tools/scripts/review-gate/status.ts",
    "review:approve-pre-implementation": "node tools/scripts/review-gate/approve-pre-implementation.ts",
    "review:reset": "node tools/scripts/review-gate/reset.ts",
    "review:checkpoint": "node tools/scripts/review/run-checkpoint-review.ts",
    "review:providers:doctor": "node tools/scripts/review/provider-doctor.ts",
    "review:plan": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint plan --provider auto --focus general",
    "review:plan:risky": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint plan --provider gemini --model gemini-2.5-pro --focus general",
    "review:implementation": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint implementation --provider auto --focus general",
    "review:test": "node tools/scripts/review/run-checkpoint-review.ts --checkpoint test --provider auto --focus tests",
    "review:local:doctor": "node tools/scripts/review/local-reviewer.ts doctor",
    "review:local:staged": "node tools/scripts/review/local-reviewer.ts staged",
    "review:local:prefilter": "node tools/scripts/review/local-reviewer.ts prefilter",
    "review:evaluate:local": "node tools/scripts/review/local-reviewer.ts evaluate",
    "review:copilot": "node tools/scripts/review/run-checkpoint-review.ts --provider copilot",
    "review:gemini": "node tools/scripts/review/run-checkpoint-review.ts --provider gemini"
  },
  "private": true,
  "devDependencies": {
    "@angular-devkit/core": "21.1.2",
    "@angular-devkit/schematics": "21.1.2",
    "@angular-eslint/eslint-plugin": "21.2.0",
    "@angular-eslint/eslint-plugin-template": "21.2.0",
    "@angular-eslint/template-parser": "21.2.0",
    "@angular/animations": "21.1.2",
    "@angular/build": "21.1.2",
    "@angular/cli": "21.1.2",
    "@angular/common": "21.1.2",
    "@angular/compiler": "21.1.2",
    "@angular/compiler-cli": "21.1.2",
    "@angular/core": "21.1.2",
    "@angular/forms": "21.1.2",
    "@angular/language-service": "21.1.2",
    "@angular/platform-browser": "21.1.2",
    "@angular/platform-browser-dynamic": "21.1.2",
    "@angular/router": "21.1.2",
    "@eslint/js": "~9.39.2",
    "@nestjs/schematics": "11.0.9",
    "@nestjs/testing": "^11.1.12",
    "@nx/angular": "22.4.4",
    "@nx/eslint": "22.4.4",
    "@nx/eslint-plugin": "22.4.4",
    "@nx/js": "22.4.4",
    "@nx/maven": "22.4.4",
    "@nx/nest": "22.4.4",
    "@nx/node": "22.4.4",
