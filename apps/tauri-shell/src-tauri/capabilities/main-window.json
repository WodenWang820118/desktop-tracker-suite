{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Capability for the main Tauri window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "updater:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "spring-backend",
          "sidecar": true
        },
        {
          "name": "nest-backend",
          "sidecar": true
        },
        {
          "name": "express-backend",
          "sidecar": true
        }
      ]
    },
    {
      "identifier": "shell:allow-kill",
      "allow": [
        {
          "name": "spring-backend",
          "sidecar": true
        },
        {
          "name": "nest-backend",
          "sidecar": true
        },
        {
          "name": "express-backend",
          "sidecar": true
        }
      ]
    }
  ]
}
