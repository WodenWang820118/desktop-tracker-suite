{
  "name": "tauri-shell",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "sourceRoot": "apps/tauri-shell/src-tauri/src",
  "tags": ["desktop", "tauri"],
  "targets": {
    "materialize-backend-runtime": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build ng-tracker --configuration production && pnpm exec nx build nest-backend --configuration production && node --experimental-strip-types tools/tauri/materialize-backend-runtime.ts"
      },
      "outputs": ["{workspaceRoot}/dist/tauri-shell/resources"]
    },
    "materialize-spring-native-runtime": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec nx build ng-tracker --configuration production && pnpm exec nx run spring-backend:native-build && node --experimental-strip-types tools/tauri/materialize-spring-native-runtime.ts"
      },
      "outputs": ["{workspaceRoot}/dist/tauri-shell-spring-native/resources"]
    },
    "smoke": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types tools/tauri/smoke-backend-runtime.ts"
      },
      "configurations": {
        "backend-runtime": {
          "command": "node --experimental-strip-types tools/tauri/smoke-backend-runtime.ts"
        },
        "spring-native-runtime": {
          "command": "node --experimental-strip-types tools/tauri/smoke-spring-native-runtime.ts"
        }
      }
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --experimental-strip-types tools/tauri/dev.ts"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["materialize-backend-runtime"],
      "options": {
        "command": "node --experimental-strip-types tools/tauri/build.ts build"
      },
      "outputs": ["{workspaceRoot}/apps/tauri-shell/src-tauri/target/debug"]
    },
    "build-spring-native": {
      "executor": "nx:run-commands",
      "dependsOn": ["materialize-spring-native-runtime"],
      "options": {
        "command": "node --experimental-strip-types tools/tauri/build.ts build spring-native"
      },
      "outputs": ["{workspaceRoot}/apps/tauri-shell/src-tauri/target/debug"]
    },
    "package": {
      "executor": "nx:run-commands",
      "dependsOn": ["materialize-backend-runtime"],
      "options": {
        "command": "node --experimental-strip-types tools/tauri/build.ts package"
      },
      "outputs": ["{workspaceRoot}/apps/tauri-shell/src-tauri/target/release/bundle"]
    },
    "package-spring-native": {
      "executor": "nx:run-commands",
      "dependsOn": ["materialize-spring-native-runtime"],
      "options": {
        "command": "node --experimental-strip-types tools/tauri/build.ts package spring-native"
      },
      "outputs": ["{workspaceRoot}/apps/tauri-shell/src-tauri/target/release/bundle"]
    }
  }
}
