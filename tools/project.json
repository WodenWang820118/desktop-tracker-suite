{
  "name": "tools",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools",
  "tags": ["tooling"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun lint --no-script .",
        "cwd": "tools"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test tools/tauri/*.test.ts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun check --no-script -p tools/tsconfig.json --no-pretty"
      }
    }
  }
}
