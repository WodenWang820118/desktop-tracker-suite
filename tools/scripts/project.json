{
  "name": "@org/scripts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/scripts",
  "tags": ["tooling"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "tools/scripts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test review/**/*.test.ts review-gate/*.test.ts",
        "cwd": "tools/scripts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm exec tsc -p tsconfig.json --pretty false && pnpm exec tsc -p tsconfig.spec.json --pretty false",
        "cwd": "tools/scripts"
      }
    }
  }
}
