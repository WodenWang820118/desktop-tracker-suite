{
  "name": "@org/scripts",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "tools/scripts",
  "tags": ["tooling"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun lint --no-script .",
        "cwd": "tools/scripts"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test review/**/*.test.ts review/**/*.spec.ts review-gate/*.test.ts",
        "cwd": "tools/scripts"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "bun check --no-script -p tsconfig.json --no-pretty && bun check --no-script -p tsconfig.spec.json --no-pretty",
        "cwd": "tools/scripts"
      }
    }
  }
}
